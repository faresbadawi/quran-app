{"source":{"text":"Tanzil Quran Text (Uthmani, v1.1) über api.alquran.cloud, Edition quran-uthmani","url":"https://tanzil.net/docs/quran_text_license","crossCheck":"Quran.com API v4 (text_uthmani, normalisierter Vergleich)","fetched":"2026-10-23"},"basmala":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","surahs":[{"number":78,"name":"النبأ","translit":"An-Naba'","de":"Die Nachricht","verses":[{"n":1,"text":"عَمَّ يَتَسَآءَلُونَ","words":["عَمَّ","يَتَسَآءَلُونَ"]},{"n":2,"text":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","words":["عَنِ","ٱلنَّبَإِ","ٱلْعَظِيمِ"]},{"n":3,"text":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","words":["ٱلَّذِى","هُمْ","فِيهِ","مُخْتَلِفُونَ"]},{"n":4,"text":"كَلَّا سَيَعْلَمُونَ","words":["كَلَّا","سَيَعْلَمُونَ"]},{"n":5,"text":"ثُمَّ كَلَّا سَيَعْلَمُونَ","words":["ثُمَّ","كَلَّا","سَيَعْلَمُونَ"]},{"n":6,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا","words":["أَلَمْ","نَجْعَلِ","ٱلْأَرْضَ","مِهَٰدًۭا"]},{"n":7,"text":"وَٱلْجِبَالَ أَوْتَادًۭا","words":["وَٱلْجِبَالَ","أَوْتَادًۭا"]},{"n":8,"text":"وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا","words":["وَخَلَقْنَٰكُمْ","أَزْوَٰجًۭا"]},{"n":9,"text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا","words":["وَجَعَلْنَا","نَوْمَكُمْ","سُبَاتًۭا"]},{"n":10,"text":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا","words":["وَجَعَلْنَا","ٱلَّيْلَ","لِبَاسًۭا"]},{"n":11,"text":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا","words":["وَجَعَلْنَا","ٱلنَّهَارَ","مَعَاشًۭا"]},{"n":12,"text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا","words":["وَبَنَيْنَا","فَوْقَكُمْ","سَبْعًۭا","شِدَادًۭا"]},{"n":13,"text":"وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا","words":["وَجَعَلْنَا","سِرَاجًۭا","وَهَّاجًۭا"]},{"n":14,"text":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا","words":["وَأَنزَلْنَا","مِنَ","ٱلْمُعْصِرَٰتِ","مَآءًۭ","ثَجَّاجًۭا"]},{"n":15,"text":"لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا","words":["لِّنُخْرِجَ","بِهِۦ","حَبًّۭا","وَنَبَاتًۭا"]},{"n":16,"text":"وَجَنَّٰتٍ أَلْفَافًا","words":["وَجَنَّٰتٍ","أَلْفَافًا"]},{"n":17,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا","words":["إِنَّ","يَوْمَ","ٱلْفَصْلِ","كَانَ","مِيقَٰتًۭا"]},{"n":18,"text":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا","words":["يَوْمَ","يُنفَخُ","فِى","ٱلصُّورِ","فَتَأْتُونَ","أَفْوَاجًۭا"]},{"n":19,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا","words":["وَفُتِحَتِ","ٱلسَّمَآءُ","فَكَانَتْ","أَبْوَٰبًۭا"]},{"n":20,"text":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","words":["وَسُيِّرَتِ","ٱلْجِبَالُ","فَكَانَتْ","سَرَابًا"]},{"n":21,"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا","words":["إِنَّ","جَهَنَّمَ","كَانَتْ","مِرْصَادًۭا"]},{"n":22,"text":"لِّلطَّٰغِينَ مَـَٔابًۭا","words":["لِّلطَّٰغِينَ","مَـَٔابًۭا"]},{"n":23,"text":"لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا","words":["لَّٰبِثِينَ","فِيهَآ","أَحْقَابًۭا"]},{"n":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا","words":["لَّا","يَذُوقُونَ","فِيهَا","بَرْدًۭا","وَلَا","شَرَابًا"]},{"n":25,"text":"إِلَّا حَمِيمًۭا وَغَسَّاقًۭا","words":["إِلَّا","حَمِيمًۭا","وَغَسَّاقًۭا"]},{"n":26,"text":"جَزَآءًۭ وِفَاقًا","words":["جَزَآءًۭ","وِفَاقًا"]},{"n":27,"text":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا","words":["إِنَّهُمْ","كَانُوا۟","لَا","يَرْجُونَ","حِسَابًۭا"]},{"n":28,"text":"وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا","words":["وَكَذَّبُوا۟","بِـَٔايَٰتِنَا","كِذَّابًۭا"]},{"n":29,"text":"وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا","words":["وَكُلَّ","شَىْءٍ","أَحْصَيْنَٰهُ","كِتَٰبًۭا"]},{"n":30,"text":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","words":["فَذُوقُوا۟","فَلَن","نَّزِيدَكُمْ","إِلَّا","عَذَابًا"]},{"n":31,"text":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","words":["إِنَّ","لِلْمُتَّقِينَ","مَفَازًا"]},{"n":32,"text":"حَدَآئِقَ وَأَعْنَٰبًۭا","words":["حَدَآئِقَ","وَأَعْنَٰبًۭا"]},{"n":33,"text":"وَكَوَاعِبَ أَتْرَابًۭا","words":["وَكَوَاعِبَ","أَتْرَابًۭا"]},{"n":34,"text":"وَكَأْسًۭا دِهَاقًۭا","words":["وَكَأْسًۭا","دِهَاقًۭا"]},{"n":35,"text":"لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا","words":["لَّا","يَسْمَعُونَ","فِيهَا","لَغْوًۭا","وَلَا","كِذَّٰبًۭا"]},{"n":36,"text":"جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا","words":["جَزَآءًۭ","مِّن","رَّبِّكَ","عَطَآءً","حِسَابًۭا"]},{"n":37,"text":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا","words":["رَّبِّ","ٱلسَّمَٰوَٰتِ","وَٱلْأَرْضِ","وَمَا","بَيْنَهُمَا","ٱلرَّحْمَٰنِ ۖ","لَا","يَمْلِكُونَ","مِنْهُ","خِطَابًۭا"]},{"n":38,"text":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا","words":["يَوْمَ","يَقُومُ","ٱلرُّوحُ","وَٱلْمَلَٰٓئِكَةُ","صَفًّۭا ۖ","لَّا","يَتَكَلَّمُونَ","إِلَّا","مَنْ","أَذِنَ","لَهُ","ٱلرَّحْمَٰنُ","وَقَالَ","صَوَابًۭا"]},{"n":39,"text":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","words":["ذَٰلِكَ","ٱلْيَوْمُ","ٱلْحَقُّ ۖ","فَمَن","شَآءَ","ٱتَّخَذَ","إِلَىٰ","رَبِّهِۦ","مَـَٔابًا"]},{"n":40,"text":"إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا","words":["إِنَّآ","أَنذَرْنَٰكُمْ","عَذَابًۭا","قَرِيبًۭا","يَوْمَ","يَنظُرُ","ٱلْمَرْءُ","مَا","قَدَّمَتْ","يَدَاهُ","وَيَقُولُ","ٱلْكَافِرُ","يَٰلَيْتَنِى","كُنتُ","تُرَٰبًۢا"]}]},{"number":79,"name":"النازعات","translit":"An-Nazi'at","de":"Die Entreißenden","verses":[{"n":1,"text":"وَٱلنَّٰزِعَٰتِ غَرْقًۭا","words":["وَٱلنَّٰزِعَٰتِ","غَرْقًۭا"]},{"n":2,"text":"وَٱلنَّٰشِطَٰتِ نَشْطًۭا","words":["وَٱلنَّٰشِطَٰتِ","نَشْطًۭا"]},{"n":3,"text":"وَٱلسَّٰبِحَٰتِ سَبْحًۭا","words":["وَٱلسَّٰبِحَٰتِ","سَبْحًۭا"]},{"n":4,"text":"فَٱلسَّٰبِقَٰتِ سَبْقًۭا","words":["فَٱلسَّٰبِقَٰتِ","سَبْقًۭا"]},{"n":5,"text":"فَٱلْمُدَبِّرَٰتِ أَمْرًۭا","words":["فَٱلْمُدَبِّرَٰتِ","أَمْرًۭا"]},{"n":6,"text":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","words":["يَوْمَ","تَرْجُفُ","ٱلرَّاجِفَةُ"]},{"n":7,"text":"تَتْبَعُهَا ٱلرَّادِفَةُ","words":["تَتْبَعُهَا","ٱلرَّادِفَةُ"]},{"n":8,"text":"قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ","words":["قُلُوبٌۭ","يَوْمَئِذٍۢ","وَاجِفَةٌ"]},{"n":9,"text":"أَبْصَٰرُهَا خَٰشِعَةٌۭ","words":["أَبْصَٰرُهَا","خَٰشِعَةٌۭ"]},{"n":10,"text":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","words":["يَقُولُونَ","أَءِنَّا","لَمَرْدُودُونَ","فِى","ٱلْحَافِرَةِ"]},{"n":11,"text":"أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ","words":["أَءِذَا","كُنَّا","عِظَٰمًۭا","نَّخِرَةًۭ"]},{"n":12,"text":"قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ","words":["قَالُوا۟","تِلْكَ","إِذًۭا","كَرَّةٌ","خَاسِرَةٌۭ"]},{"n":13,"text":"فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ","words":["فَإِنَّمَا","هِىَ","زَجْرَةٌۭ","وَٰحِدَةٌۭ"]},{"n":14,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ","words":["فَإِذَا","هُم","بِٱلسَّاهِرَةِ"]},{"n":15,"text":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","words":["هَلْ","أَتَىٰكَ","حَدِيثُ","مُوسَىٰٓ"]},{"n":16,"text":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","words":["إِذْ","نَادَىٰهُ","رَبُّهُۥ","بِٱلْوَادِ","ٱلْمُقَدَّسِ","طُوًى"]},{"n":17,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","words":["ٱذْهَبْ","إِلَىٰ","فِرْعَوْنَ","إِنَّهُۥ","طَغَىٰ"]},{"n":18,"text":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","words":["فَقُلْ","هَل","لَّكَ","إِلَىٰٓ","أَن","تَزَكَّىٰ"]},{"n":19,"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","words":["وَأَهْدِيَكَ","إِلَىٰ","رَبِّكَ","فَتَخْشَىٰ"]},{"n":20,"text":"فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ","words":["فَأَرَىٰهُ","ٱلْءَايَةَ","ٱلْكُبْرَىٰ"]},{"n":21,"text":"فَكَذَّبَ وَعَصَىٰ","words":["فَكَذَّبَ","وَعَصَىٰ"]},{"n":22,"text":"ثُمَّ أَدْبَرَ يَسْعَىٰ","words":["ثُمَّ","أَدْبَرَ","يَسْعَىٰ"]},{"n":23,"text":"فَحَشَرَ فَنَادَىٰ","words":["فَحَشَرَ","فَنَادَىٰ"]},{"n":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","words":["فَقَالَ","أَنَا۠","رَبُّكُمُ","ٱلْأَعْلَىٰ"]},{"n":25,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ","words":["فَأَخَذَهُ","ٱللَّهُ","نَكَالَ","ٱلْءَاخِرَةِ","وَٱلْأُولَىٰٓ"]},{"n":26,"text":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ","words":["إِنَّ","فِى","ذَٰلِكَ","لَعِبْرَةًۭ","لِّمَن","يَخْشَىٰٓ"]},{"n":27,"text":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","words":["ءَأَنتُمْ","أَشَدُّ","خَلْقًا","أَمِ","ٱلسَّمَآءُ ۚ","بَنَىٰهَا"]},{"n":28,"text":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","words":["رَفَعَ","سَمْكَهَا","فَسَوَّىٰهَا"]},{"n":29,"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","words":["وَأَغْطَشَ","لَيْلَهَا","وَأَخْرَجَ","ضُحَىٰهَا"]},{"n":30,"text":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","words":["وَٱلْأَرْضَ","بَعْدَ","ذَٰلِكَ","دَحَىٰهَآ"]},{"n":31,"text":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","words":["أَخْرَجَ","مِنْهَا","مَآءَهَا","وَمَرْعَىٰهَا"]},{"n":32,"text":"وَٱلْجِبَالَ أَرْسَىٰهَا","words":["وَٱلْجِبَالَ","أَرْسَىٰهَا"]},{"n":33,"text":"مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","words":["مَتَٰعًۭا","لَّكُمْ","وَلِأَنْعَٰمِكُمْ"]},{"n":34,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","words":["فَإِذَا","جَآءَتِ","ٱلطَّآمَّةُ","ٱلْكُبْرَىٰ"]},{"n":35,"text":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ","words":["يَوْمَ","يَتَذَكَّرُ","ٱلْإِنسَٰنُ","مَا","سَعَىٰ"]},{"n":36,"text":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","words":["وَبُرِّزَتِ","ٱلْجَحِيمُ","لِمَن","يَرَىٰ"]},{"n":37,"text":"فَأَمَّا مَن طَغَىٰ","words":["فَأَمَّا","مَن","طَغَىٰ"]},{"n":38,"text":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","words":["وَءَاثَرَ","ٱلْحَيَوٰةَ","ٱلدُّنْيَا"]},{"n":39,"text":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","words":["فَإِنَّ","ٱلْجَحِيمَ","هِىَ","ٱلْمَأْوَىٰ"]},{"n":40,"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","words":["وَأَمَّا","مَنْ","خَافَ","مَقَامَ","رَبِّهِۦ","وَنَهَى","ٱلنَّفْسَ","عَنِ","ٱلْهَوَىٰ"]},{"n":41,"text":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","words":["فَإِنَّ","ٱلْجَنَّةَ","هِىَ","ٱلْمَأْوَىٰ"]},{"n":42,"text":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","words":["يَسْـَٔلُونَكَ","عَنِ","ٱلسَّاعَةِ","أَيَّانَ","مُرْسَىٰهَا"]},{"n":43,"text":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","words":["فِيمَ","أَنتَ","مِن","ذِكْرَىٰهَآ"]},{"n":44,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","words":["إِلَىٰ","رَبِّكَ","مُنتَهَىٰهَآ"]},{"n":45,"text":"إِنَّمَآ أَنتَ مُنذِرُ م